# Deployr Environment Variables

# Optional: Path to custom Chromium/Chrome/Edge/Brave executable for Lighthouse
# DEPLOYR_BROWSER_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
# DEPLOYR_BROWSER_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# DEPLOYR_BROWSER_PATH="/usr/bin/google-chrome"
DEPLOYR_BROWSER_PATH=

# Optional: Standard Chrome binary path override
# CHROME_PATH="/path/to/chrome"
CHROME_PATH=

# Optional: Disable terminal color formatting (set to 1 or true)
# NO_COLOR=1
NO_COLOR=
